# Example .env.example — DO NOT STORE SECRETS HERE
# Copy to .env and fill real secret values before running

DATABASE_URL=jdbc:postgresql://localhost:5432/planner
DATABASE_USERNAME=planner
DATABASE_PASSWORD=planner

DATABASE_TEST_URL=jdbc:postgresql://localhost:5432/planner_test
DATABASE_TEST_USERNAME=planner
DATABASE_TEST_PASSWORD=planner

FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET_KEY=change_this_to_a_secure_key_min_32_chars
JWT_EXPIRATION=900000

# Kafka (use default for local dev)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_CONSUMER_GROUP_ID=notification-group

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
